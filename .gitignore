/omatty
/crapcheck
/depcheck
cover.out

# Compiled test binaries from `go test -c`. Not root-anchored: the extension
# cannot collide with a package directory, and the artefact lands wherever it
# was built (#320).
*.test

# GoReleaser output (#327).
/dist/
